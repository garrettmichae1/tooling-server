# syntax=docker/dockerfile:1
FROM rust:1-bookworm@sha256:b36c246742b4d323472588f789601be34eb4af053255e2af53969078ee8dcec7 AS rust
FROM golang:1.27-bookworm@sha256:55395706e9703db746cc507abfc4eb2aea75918f8a8024e4848e2cb81004f5ad
RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/* && mkdir -p /opt/rust/bin && ln -s /usr/local/go /opt/go
COPY --from=rust /usr/local/cargo /opt/rust/cargo
COPY --from=rust /usr/local/rustup /opt/rust/rustup
RUN chmod -R a+rX /opt/rust
RUN ln -s /opt/rust/cargo/bin/* /opt/rust/bin/

# Compile standard packages once in the published image, rather than spending
# each 30-second job rebuilding them. Cloudflare gives every job its own fresh
# writable image disk and destroys it afterward; this cache is never a volume
# shared across jobs. It contains only Go's pinned standard library at build time.
RUN GOCACHE=/opt/go-cache GOMAXPROCS=1 GOPROXY=off GOSUMDB=off /opt/go/bin/go install -p 1 std && chown -R 65532:65532 /opt/go-cache

# Controller has no secrets. Submitted programs are demoted to UID/GID 65532.
RUN find / -xdev -type f -perm /6000 -exec chmod a-s {} + && mkdir -p /opt/edsger
COPY runtime/runner.py /opt/edsger/runner.py
EXPOSE 8080
STOPSIGNAL SIGTERM
ENTRYPOINT ["/usr/bin/python3", "-u", "/opt/edsger/runner.py"]
