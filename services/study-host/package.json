{
  "name": "@edsger/study-tool-host",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "tsc --outDir .test-build && node tests/gateway.test.mjs",
    "check:runtime": "node tests/runtime-check.mjs",
    "check:container": "node tests/container-check.mjs",
    "build:check": "wrangler deploy --dry-run --outdir .wrangler/review",
    "deploy:sandbox": "wrangler deploy --var STUDY_HOST_ENABLED:true"
  },
  "dependencies": {
    "@cloudflare/containers": "0.3.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261003.1",
    "typescript": "5.9.3",
    "wrangler": "4.147.0"
  }
}
